# CPU default. Copy to .env. Build scripts read these packaging settings.
KEV_IMAGE=kev-ranker:1.0-cpu
KEV_BUNDLE_MODEL=kev-0.8b
KEV_MODEL=kev-0.8b
KEV_TORCH_INDEX=https://download.pytorch.org/whl/cpu
KEV_DEVICE=cpu
KEV_DTYPE=auto
KEV_CPU_THREADS=6
KEV_BIND_IP=0.0.0.0
KEV_HOST_PORT=8009
KEV_API_KEY=
DEBUG_MODE=false
KEV_MAX_REQUEST_BYTES=2097152
KEV_MAX_UPLOAD_BYTES=33554432
KEV_MAX_RECORDS=10000
KEV_MAX_QUESTIONS=64
KEV_MAX_CONCURRENCY=8
KEV_INFERENCE_TIMEOUT=300
KEV_STARTUP_TIMEOUT=600
KEV_TRAINING_TIMEOUT=86400
KEV_VALIDATION_TIMEOUT=300

